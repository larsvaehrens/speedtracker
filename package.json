{
  "name": "speedtracker",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vp dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vp build",
    "preview": "vp preview",
    "deploy": "pnpm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply speedtracker-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply speedtracker-db --remote",
    "db:seed:user": "node scripts/seed-user.mjs",
    "check": "vp check",
    "test": "vp test",
    "typecheck": "pnpm cf-typegen && tsc --noEmit",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.6",
    "@tanstack/react-router": "1.170.40",
    "@tanstack/react-start": "1.168.59",
    "better-auth": "1.7.6",
    "drizzle-orm": "0.45.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.2",
    "@tanstack/router-cli": "1.167.39",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "5.0.1",
    "wrangler": "4.144.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "10.33.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@10.33.0"
}
